FROM node:22-alpine

WORKDIR /workspace

RUN corepack enable

COPY package.json pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/web/scripts ./apps/web/scripts

RUN pnpm install --filter @app/web... --no-frozen-lockfile

CMD ["pnpm", "-C", "apps/web", "export:read-models"]
